---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
const wa=(service='un proyecto')=>`https://wa.me/51942795641?text=${encodeURIComponent(`Hola Emerson, me gustaría cotizar ${service}. ¿Podemos conversar sobre lo que necesito?`)}`;
const services=[{n:'01',icon:'bolt',name:'Automatización de reportes',text:'Deja de copiar y pegar cada semana. Conecto tus fuentes y preparo flujos para que la información llegue cuando la necesitas.',items:['Integración de Excel, bases de datos y APIs','Procesos ETL con Python y SQL','Reportes programados y documentados'],label:'Quiero automatizar',topic:'la automatización de mis reportes'}, {n:'02',icon:'chart',name:'Análisis de datos',text:'Dale contexto a tus números. Organizo tus datos y construyo indicadores que te ayuden a entender qué pasa y dónde actuar.',items:['Limpieza y preparación de datos','Dashboards en Power BI y Grafana','Indicadores y visualizaciones para decidir'],label:'Quiero entender mis datos',topic:'un análisis de datos'}, {n:'03',icon:'code',name:'Desarrollo web',text:'Una presencia digital a la altura de tu trabajo. Páginas claras, rápidas y pensadas para convertir visitas en conversaciones.',items:['Landing pages y sitios profesionales','Diseño adaptable a móviles','Contacto por WhatsApp y SEO básico'],label:'Quiero mi página web',topic:'una página web'}];
services.push({n:'04',icon:'globe',name:'Soporte remoto',text:'Cuando una aplicación falla, necesitas recuperar el control. Te ayudo a investigar el problema y definir los siguientes pasos con claridad.',items:['Diagnóstico de aplicaciones, servicios y logs','Revisión de SQL Server y conectividad','Asistencia remota y documentación técnica'],label:'Necesito soporte',topic:'una sesión de soporte remoto'});
const faqs=[['¿Trabajas con empresas y profesionales independientes?','Sí. Podemos trabajar en una web para tu marca personal, en los reportes de tu negocio o en una solución de datos para tu equipo. El alcance se define según tu necesidad.'],['¿Cuánto cuesta un proyecto?','La cotización es personalizada. Primero revisamos el objetivo, las fuentes de datos o el contenido disponible, los entregables y el plazo. Con esa información preparo una propuesta con alcance y precio.'],['¿Tengo que saber de tecnología para empezar?','No. Cuéntame qué tarea te toma tiempo, qué información necesitas o qué quieres mostrar en tu web. Te ayudo a convertir esa necesidad en un alcance concreto.'],['¿Qué necesito para una página web?','Tu objetivo, una descripción de tus servicios y un medio de contacto. Revisamos juntos los textos, las imágenes, el dominio y el alojamiento; sus costos y responsabilidades se detallan en la propuesta.'],['¿Incluyes soporte y documentación?','La propuesta especifica la documentación, la entrega y el período de soporte incluido. El mantenimiento y las mejoras posteriores se pueden cotizar por separado.']];
---
<!doctype html>
<html lang="es">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Emerson Yurivilca | Datos, automatización y desarrollo web</title>
<meta name="description" content="Automatización de reportes, análisis de datos y páginas web para negocios y profesionales. Emerson Yurivilca, Lima, Perú. Cotiza tu proyecto por WhatsApp."/>
<meta name="theme-color" content="#101311"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
<link rel="canonical" href={Astro.url.origin}/>
<meta property="og:title" content="Emerson Yurivilca | Tecnología que hace avanzar tu negocio"/><meta property="og:description" content="Datos, automatización y desarrollo web para tu negocio. Conversemos sobre tu próximo proyecto."/><meta property="og:type" content="website"/><meta property="og:locale" content="es_PE"/><meta property="og:image" content={`${Astro.url.origin}/emerson-720.webp`}/>
</head>
<body>
<a class="skip" href="#contenido">Saltar al contenido</a>
<header class="header"><nav class="container nav" aria-label="Navegación principal"><a class="brand" href="#inicio" aria-label="Emerson Yurivilca, inicio"><span class="monogram">ey<span>.</span></span><span>EMERSON<br/>YURIVILCA</span></a><div class="desktop-links"><a href="#servicios">Servicios</a><a href="#enfoque">Mi enfoque</a><a href="#sobre-mi">Sobre mí</a></div><a class="nav-cta" href={wa()} target="_blank" rel="noopener noreferrer">Hablemos </a><details class="mobile-menu"><summary aria-label="Abrir menú">☰</summary><div><a href="#servicios">Servicios</a><a href="#enfoque">Mi enfoque</a><a href="#sobre-mi">Sobre mí</a><a href="#contacto">Contacto</a></div></details></nav></header>
<main id="contenido">
<section class="container hero" id="inicio"><div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> TECNOLOGÍA CON PROPÓSITO</p><p class="intro">Hola, soy Emerson Yurivilca </p><h1>Menos tareas.<br/>Más claridad.<br/><span>Mejor negocio.</span></h1><p class="hero-description">Datos, automatización y desarrollo web para tu negocio. Te ayudo a simplificar procesos, entender tus números y llevar tu trabajo a la web, con soporte remoto cuando lo necesitas.</p><div class="hero-actions"><a class="button primary" href={wa()} target="_blank" rel="noopener noreferrer">Cotiza tu proyecto </a><a class="text-link" href="#servicios">Explora los servicios </a></div><p class="location"><span>◎</span> Desde Lima, Perú · Atención remota</p></div><div class="portrait-wrap"><div class="portrait-top"><span>PERSONAS + DATOS + TECNOLOGÍA</span><span>01 / EY</span></div><div class="portrait"><img src="/emerson-720.webp" srcset="/emerson-400.webp 400w, /emerson-720.webp 720w" sizes="(max-width: 760px) 90vw, 420px" width="720" height="720" alt="Emerson Yurivilca, especialista en tecnología y datos" fetchpriority="high"/><div class="portrait-caption"><span class="status-dot"></span><span>Tu próximo proyecto<br/><strong>empieza con una conversación.</strong></span></div></div><div class="portrait-bottom"><span>&lt; ideas que se convierten en soluciones /&gt;</span><span>✳</span></div></div></section>
<div class="tech-strip"><div class="container tech-inner"><span class="tech-label">HERRAMIENTAS CON LAS QUE TRABAJO</span><div>{['Python','SQL Server','Power BI','Grafana','Astro','Tailwind CSS'].map(label=><span>{label}</span>)}</div></div></div>
<section class="container section" id="servicios"><div class="section-heading"><div><p class="eyebrow">01 — CÓMO PUEDO AYUDARTE</p><h2>Tu siguiente paso,<br/><span class="muted">con la tecnología adecuada.</span></h2></div><p>No necesitas todas las herramientas.<br/>Necesitas una solución que resuelva<br/>el problema correcto.</p></div><div class="services">{services.map(s=><article class="service"><div class="service-top"><span class="icon-box"><Icon name={s.icon} size={26}/></span><span class="number">/{s.n}</span></div><h3>{s.name}</h3><p>{s.text}</p><ul>{s.items.map(i=><li><Icon name="check" size={16}/>{i}</li>)}</ul><a href={wa(s.topic)} target="_blank" rel="noopener noreferrer">{s.label}</a></article>)}</div></section>
<section class="section approach-section" id="enfoque"><div class="container approach"><div><p class="eyebrow">02 — DE LOS DATOS A LA ACCIÓN</p><h2>Información útil.<br/><span class="muted">Decisiones más claras.</span></h2><p class="body-copy">Un reporte debe responder preguntas, no sumar más archivos. Partimos de lo que necesitas saber y construimos una forma clara de verlo.</p><div class="approach-points"><p><span>01</span><strong>Conectar</strong><small>Reunir la información que hoy está dispersa.</small></p><p><span>02</span><strong>Entender</strong><small>Elegir indicadores con sentido para tu operación.</small></p><p><span>03</span><strong>Actuar</strong><small>Identificar qué necesita atención y por qué.</small></p></div></div><div class="demo"><div class="demo-header"><span class="demo-brand">ey<span>.</span> <small>INSIGHTS</small></span><span class="demo-tag">EJEMPLO ILUSTRATIVO</span></div><div class="demo-title"><div><small>UNA VISTA PARA ENTENDER TU NEGOCIO</small><h3>De la información a la acción</h3></div><span class="demo-dot"></span></div><div class="demo-tabs" role="tablist" aria-label="Ejemplos de indicadores"><button id="tab-reportes" role="tab" aria-controls="panel-demo" aria-selected="true" data-demo="reportes">Reportes</button><button id="tab-ventas" role="tab" aria-controls="panel-demo" aria-selected="false" tabindex="-1" data-demo="ventas">Ventas</button><button id="tab-operacion" role="tab" aria-controls="panel-demo" aria-selected="false" tabindex="-1" data-demo="operacion">Operación</button></div><div id="panel-demo" role="tabpanel" aria-labelledby="tab-reportes"><div class="demo-metrics"><div><small id="metric-label">Reportes preparados</small><strong id="metric-value">24 <span>/ 30</span></strong></div><div><small id="metric-note">Pendientes de revisión</small><strong id="metric-secondary">06</strong></div></div><div class="chart-head"><span id="chart-label">Preparación de reportes por semana</span><small>DATOS DE DEMOSTRACIÓN</small></div><div class="bars" aria-hidden="true">{[44,62,50,77,66,92,82].map((h,i)=><div><span style={`height:${h}%`}></span><small>S{i+1}</small></div>)}</div><div class="demo-insight"><p id="insight">Identifica los reportes pendientes y prioriza su revisión antes del próximo cierre.</p></div></div><p class="demo-disclaimer">Datos ficticios para mostrar el enfoque. Tu solución se diseña según tus objetivos.</p></div></div></section>
<section class="container section about" id="sobre-mi"><div class="about-side"><p class="eyebrow">03 — DETRÁS DE LAS SOLUCIONES</p><h2>Tecnología con<br/><span class="muted">experiencia en terreno.</span></h2><a class="text-link" href="https://www.linkedin.com/in/emersonyurivilca/" target="_blank" rel="noopener noreferrer">Conoce mi perfil en LinkedIn </a></div><div class="about-copy"><p class="big-copy">Soy Emerson, profesional de tecnología con experiencia en soporte de aplicaciones, datos y operaciones.</p><p>He trabajado con equipos en distintos países de Latinoamérica, resolviendo problemas donde el software, la infraestructura y la operación se encuentran.</p><p>Hoy pongo esa experiencia al servicio de empresas y profesionales que buscan automatizar su trabajo, aprovechar sus datos y construir una presencia digital clara. También brindo soporte remoto para diagnosticar problemas en aplicaciones, bases de datos y servicios.</p><div class="about-tags"><span>SQL & Python</span><span>Integración de datos</span><span>Desarrollo web</span><span>Soporte remoto</span><span>IA aplicada</span></div></div></section>
<section class="container section ai-section" id="ia"><div><p class="eyebrow">04 — IA APLICADA AL TRABAJO</p><h2>Una herramienta más.<br/><span class="muted">Tu criterio sigue al centro.</span></h2><p class="body-copy">Uso asistentes de IA para apoyar la programación, explorar datos y preparar documentación. Cada resultado necesita revisión, pruebas y contexto antes de llevarlo a una solución real.</p></div><div class="ai-panel"><div class="ai-tools">{['ChatGPT','Claude','Gemini'].map(tool=><span>{tool}</span>)}</div><h3>Del prompt a una solución comprobable</h3><ul><li>Definir objetivos y requisitos antes de generar código.</li><li>Revisar consultas, scripts y análisis con datos de prueba.</li><li>Documentar decisiones y validar los resultados.</li></ul><p class="ai-learning"> En exploración: agentes de IA e integraciones con MCP.</p></div></section><section class="container section process"><div class="section-heading"><div><p class="eyebrow">05 — UNA FORMA CLARA DE TRABAJAR</p><h2>Del “necesito” al <span class="accent">“listo”.</span></h2></div><p>Alcance definido y comunicación directa,<br/>desde la primera conversación.</p></div><div class="steps">{[{n:'01',t:'Conversamos',d:'Me cuentas qué necesitas, cómo trabajas y qué quieres mejorar.'},{n:'02',t:'Definimos',d:'Recibes una propuesta con alcance, entregables, plazos y cotización.'},{n:'03',t:'Construimos',d:'Desarrollo la solución y revisamos los avances acordados.'},{n:'04',t:'Entregamos',d:'Validamos el resultado y revisamos su uso y documentación.'}].map(s=><div><span>{s.n}</span><h3>{s.t}</h3><p>{s.d}</p></div>)}</div></section>
<section class="container section faq"><div><p class="eyebrow">06 — ANTES DE EMPEZAR</p><h2>¿Alguna duda?</h2><p class="body-copy">Conversemos con claridad<br/>desde el principio.</p></div><div class="faq-list">{faqs.map(([q,a])=><details><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></section>
<section class="container contact section" id="contacto"><div><p class="eyebrow"><span class="status-dot"></span> HAGAMOS QUE SUCEDA</p><h2>Tu idea merece<br/><span class="accent">un siguiente paso.</span></h2><p>Cuéntame qué quieres resolver.<br/>Empezamos con una conversación y una cotización personalizada.</p></div><form id="contact-form"><label for="service">¿En qué puedo ayudarte?</label><select id="service" name="service"><option value="la automatización de mis reportes">Automatización de reportes</option><option value="un análisis de datos">Análisis de datos</option><option value="una página web">Página web</option><option value="una sesión de soporte remoto">Soporte remoto</option><option value="un proyecto de tecnología">Necesito orientación</option></select><label for="message">Cuéntame un poco de tu proyecto <span>(opcional)</span></label><textarea id="message" name="message" rows="3" maxlength="1000" placeholder="¿Qué te gustaría mejorar o crear?"></textarea><button class="button primary" type="submit">Conversar por WhatsApp </button><small>Se abrirá WhatsApp con tu mensaje para que puedas revisarlo y enviarlo.</small><noscript><a href={wa()}>Escríbeme directamente por WhatsApp</a></noscript></form></section>
</main>
<footer class="container footer"><a class="brand" href="#inicio"><span class="monogram">ey<span>.</span></span><span>EMERSON YURIVILCA<small>Datos · Automatización · Web</small></span></a><p>© {new Date().getFullYear()} Emerson Yurivilca</p><div><a href="https://www.linkedin.com/in/emersonyurivilca/" target="_blank" rel="noopener noreferrer"><Icon name="linkedin" size={17}/> LinkedIn </a><a href="https://github.com/eyurivilc" target="_blank" rel="noopener noreferrer"><Icon name="github" size={17}/> GitHub </a><a href={wa()} target="_blank" rel="noopener noreferrer"><Icon name="chat" size={17}/> WhatsApp </a></div></footer>
<script>
const form=document.querySelector<HTMLFormElement>('#contact-form');
form?.addEventListener('submit',e=>{e.preventDefault(); const data=new FormData(form); const note=String(data.get('message')||'').trim(); const message=`Hola Emerson, me gustaría cotizar ${data.get('service')}.${note?'\n\n'+note:''}`; window.location.href=`https://wa.me/51942795641?text=${encodeURIComponent(message)}`;});
const demos={reportes:{label:'Reportes preparados',value:'24 <span>/ 30</span>',note:'Pendientes de revisión',secondary:'06',chart:'Preparación de reportes por semana',insight:'Identifica los reportes pendientes y prioriza su revisión antes del próximo cierre.',bars:[44,62,50,77,66,92,82]},ventas:{label:'Ventas del período',value:'S/ 18<span>,400</span>',note:'Pedidos registrados',secondary:'46',chart:'Ventas por semana',insight:'Compara períodos y revisa qué semanas necesitan una investigación más detallada.',bars:[60,45,72,52,85,68,94]},operacion:{label:'Tareas completadas',value:'36 <span>/ 40</span>',note:'Tareas pendientes',secondary:'04',chart:'Tareas completadas por semana',insight:'Detecta la carga pendiente y conversa con tu equipo sobre las prioridades del período.',bars:[50,70,55,88,65,78,90]}};
const tabs=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-demo]'));
function activate(tab:HTMLButtonElement){const key=tab.dataset.demo as keyof typeof demos;const d=demos[key];tabs.forEach(t=>{t.setAttribute('aria-selected',String(t===tab));t.tabIndex=t===tab?0:-1;});document.querySelector('#panel-demo')?.setAttribute('aria-labelledby',tab.id);const fields={'metric-label':d.label,'metric-note':d.note,'metric-secondary':d.secondary,'chart-label':d.chart,insight:d.insight};Object.entries(fields).forEach(([id,v])=>{document.getElementById(id)!.textContent=v;});document.getElementById('metric-value')!.innerHTML=d.value;document.querySelectorAll<HTMLElement>('.bars>div>span').forEach((el,i)=>el.style.height=d.bars[i]+'%');}
tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>activate(tab));tab.addEventListener('keydown',e=>{let n=i;if(e.key==='ArrowRight') n=(i+1)%tabs.length;else if(e.key==='ArrowLeft') n=(i+tabs.length-1)%tabs.length;else if(e.key==='Home') n=0;else if(e.key==='End') n=tabs.length-1;else return;e.preventDefault();activate(tabs[n]);tabs[n].focus();});});
document.querySelectorAll('.mobile-menu a').forEach(a=>a.addEventListener('click',()=>document.querySelector('.mobile-menu')?.removeAttribute('open')));
</script>
</body></html>
